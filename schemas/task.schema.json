{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restingrobot.local/schemas/task.schema.json",
  "title": "Agentic Delivery Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "role",
    "status",
    "risk",
    "requirement_ids",
    "dependencies",
    "allowed_paths",
    "forbidden_paths",
    "acceptance_criteria",
    "verification_commands",
    "required_evidence",
    "human_gate"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "role": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "solution_architect",
        "task_planner",
        "frontend_engineer",
        "backend_engineer",
        "database_engineer",
        "design_reviewer",
        "qa_engineer",
        "security_reviewer",
        "devops_engineer",
        "code_reviewer"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "in_progress", "blocked", "review", "done"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "requirement_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "human_gate": { "type": "boolean" }
  },
  "additionalProperties": false
}
