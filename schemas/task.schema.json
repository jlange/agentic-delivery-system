{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restingrobot.local/schemas/task.schema.json",
  "title": "Agentic Delivery Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "role",
    "status",
    "risk",
    "requirement_ids",
    "dependencies",
    "allowed_paths",
    "forbidden_paths",
    "acceptance_criteria",
    "verification_commands",
    "required_evidence",
    "human_gate",
    "approval",
    "execution_gate",
    "contracts",
    "runtime_resources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "role": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "solution_architect",
        "task_planner",
        "frontend_engineer",
        "backend_engineer",
        "database_engineer",
        "design_reviewer",
        "qa_engineer",
        "security_reviewer",
        "devops_engineer",
        "code_reviewer"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned", "awaiting_approval", "approved_blocked_by_dependency",
        "approved", "executable", "implementing", "amendment_requested",
        "amendment_approved", "verifying", "independent_review",
        "pull_request_open", "changes_requested", "review_approved", "merged",
        "cancelled"
      ]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "requirement_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "human_gate": { "type": "boolean" },
    "approval": {
      "type": "object",
      "required": ["status", "artifact", "scope"],
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "artifact": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "required": ["approved_by", "approved_at"] }
        }
      ],
      "additionalProperties": false
    },
    "execution_gate": {
      "type": "object",
      "required": ["requires_merged"],
      "properties": {
        "requires_merged": { "type": "array", "items": { "type": "string" } },
        "required_integration_revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": ["reads", "writes"],
      "properties": {
        "reads": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "runtime_resources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requested_path", "reason", "permitted_change", "status"],
        "properties": {
          "requested_path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "permitted_change": { "type": "string", "minLength": 1 },
          "additional_verification": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["requested", "approved", "rejected"] },
          "approval_artifact": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
